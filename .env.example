# geo-audit — environment variables
#
# Copy this file to .env and fill in only the keys you have. Missing keys
# cause modules to degrade gracefully — the audit still runs and tells
# you exactly what each missing key would unlock.
#
# .env is gitignored — never commit your real keys.
#
# Run `geo-audit doctor` after editing .env to see which modules become
# active.


# ── REQUIRED for live brand-mention scan (pick AT LEAST ONE) ────────
# Each LLM key unlocks the brand-mention scan in the corresponding LLM.
# Cost: ~$0.001 per audit. Cheap.

# Anthropic — Claude (Haiku-class is fastest for our workload).
# Get one: https://console.anthropic.com/settings/keys
# Free tier: no — but $5 minimum credit lasts hundreds of audits.
ANTHROPIC_API_KEY=

# OpenAI — ChatGPT.
# Get one: https://platform.openai.com/api-keys
# Free tier: no — but gpt-4o-mini is ~$0.001 per audit.
OPENAI_API_KEY=

# Perplexity — live brand-mention check in Perplexity AI search.
# Has built-in web search — most accurate signal for "is my brand cited?"
# Get one: https://www.perplexity.ai/settings/api
# Free tier: yes — $5 free credits on signup.
PERPLEXITY_API_KEY=

# Google Gemini — proxy for Google AI Overviews readiness.
# Get one: https://ai.google.dev/gemini-api/docs/api-key
# Free tier: yes — generous.
GEMINI_API_KEY=


# ── HIGHLY RECOMMENDED (free tier available) ────────────────────────

# Google PageSpeed Insights — Core Web Vitals (LCP/INP/CLS).
# Get one: https://developers.google.com/speed/docs/insights/v5/get-started
# Free tier: yes — 25,000 queries/day free.
PAGESPEED_API_KEY=


# ── Auto-fallback fetcher (recommended for hostile targets) ─────────

# Firecrawl — used as automatic fallback when the direct httpx fetch
# returns Cloudflare/DataDome challenge HTML, an empty SPA shell, or
# any 4xx/5xx. Without it, ~30% of real-world sites can't be fully
# audited (especially Cloudflare-protected SaaS and JS-heavy SPAs).
# Get one: https://www.firecrawl.dev/app/api-keys
# Free tier: yes — 500 requests/month free.
# Force always-on (skip direct httpx attempt): FIRECRAWL_FORCE=1
FIRECRAWL_API_KEY=


# ── Improves brand-mention accuracy ─────────────────────────────────

# Tavily — when set, geo-audit grounds the Claude / ChatGPT / Gemini
# brand-mention queries with live web search results from Tavily.
# Significantly improves accuracy for non-Perplexity providers (which
# don't have built-in web search). Skip for Perplexity (it already has
# its own search).
# Get one: https://app.tavily.com/home
# Free tier: yes — 1,000 searches/month free.
TAVILY_API_KEY=


# ── Cache settings (rarely changed) ─────────────────────────────────

# Where to write the HTTP cache. Default: ~/.cache/geo-audit/
# GEO_AUDIT_CACHE_DIR=

# Force Firecrawl on every fetch (skip direct httpx attempt). Useful
# when auditing a known hostile target — saves a wasted httpx round trip.
# FIRECRAWL_FORCE=1


# Notes
# -----
# - All keys live ONLY on your machine.
# - geo-audit makes calls only to the documented endpoints (see TRUST.md).
# - There is NO HWAI relay, NO telemetry, NO phone-home.
# - Read scripts/agent-preinstall-check.sh before running install.sh.
#
# Roadmap (declared but not yet wired in v0.2):
#   - ORIGINALITY_API_KEY, GPTZERO_API_KEY (paid AI-content detection)
#   - SERPER_API_KEY, SEARXNG_BASE_URL    (alternative SERP backends)
#   - YANDEX_XML_USER + YANDEX_XML_KEY    (Russian-market AI search)
# These will appear in a future minor release. Until then they're not
# read, and setting them has no effect.
