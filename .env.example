# Example environment file for geo-audit.
# Copy to .env and fill in keys you have. .env is gitignored — never commit it.

# ── Free tier (recommended starter) ────────────────────────────────
# Google PageSpeed Insights — for Core Web Vitals (technical module).
# Sign up: https://console.cloud.google.com/apis/library/pagespeedonline.googleapis.com
# Free tier: 25,000 queries/day.
PAGESPEED_API_KEY=

# Google Gemini — for brand-mentions module.
# Sign up: https://aistudio.google.com
# Free tier: generous.
GEMINI_API_KEY=

# Tavily Search — LLM-friendly web search for context expansion.
# Sign up: https://tavily.com
# Free tier: 1,000 searches/month.
TAVILY_API_KEY=

# ── Paid (~$0.001 per audit each) ──────────────────────────────────
# OpenAI — for ChatGPT brand mention scan (brand-mentions module).
# Sign up: https://platform.openai.com
OPENAI_API_KEY=

# Anthropic — for Claude brand mention scan (brand-mentions module).
# Sign up: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Perplexity — for Perplexity citation check (brand-mentions module).
# Sign up: https://docs.perplexity.ai
PERPLEXITY_API_KEY=

# ── Optional infrastructure ────────────────────────────────────────
# Self-hosted SearXNG — alternative to Serper for SERP queries.
# Setup: https://docs.searxng.org/admin/installation.html
# Set this OR SERPER_API_KEY, not both.
SEARXNG_BASE_URL=

# Serper.dev — Google SERP fetcher.
# Sign up: https://serper.dev
SERPER_API_KEY=

# ── Notes ──────────────────────────────────────────────────────────
# - All keys are read locally and sent only to their respective endpoints.
# - No telemetry from geo-audit to Humanswith.ai.
# - Missing keys → modules degrade gracefully with a warning, not a crash.
# - See docs/external-services.md for full details.
